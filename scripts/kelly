#!/data/data/com.termux/files/usr/bin/bash
# Commande « kelly » pour Termux. Installée par : cp ~/kelly/scripts/kelly $PREFIX/bin/kelly && chmod +x $PREFIX/bin/kelly
# « kelly update » la réinstalle toute seule après chaque git pull.
DIR="$HOME/kelly"
LOG="$DIR/logs/termux.log"

STOPPED="$DIR/logs/stopped"      # « kelly stop » : la garde ne relance plus Kelly
BOOT="$HOME/.termux/boot/kelly"
running() { pgrep -f "termux_runner.py" > /dev/null; }
has() { command -v "$1" > /dev/null 2>&1; }

# Termux:Boot : Kelly relancée au démarrage du téléphone (après le premier déverrouillage)
install_boot() {
    mkdir -p "$HOME/.termux/boot" 2>/dev/null || return 0
    printf '%s\n' '#!/data/data/com.termux/files/usr/bin/sh' \
        '# Kelly relancée au démarrage du téléphone (Termux:Boot). Écrit par « kelly start » : ne pas modifier.' \
        'sleep 20' \
        'L=/data/data/com.termux/files/home/kelly/logs; mkdir -p $L; date -u "+démarrage du téléphone %Y-%m-%d %H:%M UTC" >> $L/boot.log' \
        '[ -f $L/stopped ] && { echo "Kelly arrêtée par kelly stop : pas relancée" >> $L/boot.log; exit 0; }' \
        'termux-wake-lock' \
        '/data/data/com.termux/files/usr/bin/kelly start >> $L/boot.log 2>&1' > "$BOOT.tmp" &&
        chmod +x "$BOOT.tmp" && mv -f "$BOOT.tmp" "$BOOT"
}

# garde : relance Kelly toutes les 5 min si elle s'est arrêtée sans « kelly stop » (plantage, processus tué)
start_guard() {
    pgrep -f "kelly guard" > /dev/null || nohup "$0" guard > /dev/null 2>&1 &
}

# test d'une nouvelle version avant de la lancer : imports, puis matin d'essai hors ligne (données fictives, dossier temporaire, aucun envoi)
selftest() {
    local d rc
    d=$(mktemp -d)
    ( cd "$DIR" && unset TELEGRAM_TOKEN TELEGRAM_CHAT_ID XBET_PROXY
      DATA_DIR="$d" QUIET_HOURS=off timeout 300 python -c "import termux_runner, kelly.app, kelly.watch, kelly.chat, kelly.backup" &&
      DATA_DIR="$d" QUIET_HOURS=off timeout 900 python bot.py --sample ) > "$DIR/logs/update_test.log" 2>&1
    rc=$?
    rm -rf "$d"
    return $rc
}

# miroir de la base (data/sauvegarde, réécrit chaque soir) : mis de côté pendant la mise à jour, git n'y touche jamais
keep_mirror() { rm -rf "$DIR/logs/.miroir"; [ -d "$DIR/data/sauvegarde" ] && cp -a "$DIR/data/sauvegarde" "$DIR/logs/.miroir"; git -C "$DIR" checkout -q -- data/sauvegarde 2>/dev/null; true; }
put_mirror() { [ -d "$DIR/logs/.miroir" ] && mkdir -p "$DIR/data/sauvegarde" && cp -a "$DIR/logs/.miroir/." "$DIR/data/sauvegarde/" && rm -rf "$DIR/logs/.miroir"; true; }

notify() {      # message Telegram depuis le script (code de n'importe quelle version : seulement telegram.send)
    ( cd "$DIR" && python -c "import sys; from kelly import envfile; envfile.load(); from kelly import telegram; telegram.send(sys.argv[1])" "$1" ) > /dev/null 2>&1
}

# intégration continue : « kelly update » n'installe pas un commit dont la CI (GitHub Actions, .github/workflows/tests.yml) n'est pas verte. L'état vient de l'API publique de GitHub
# (dépôt public, sans jeton) : verte | rouge | en cours | injoignable. KELLY_CI_FIXTURE (un fichier JSON, ou « unreachable ») remplace le réseau pour les tests (tests/test_ci_guard.py).
ci_repo() {
    local u
    u=$(git -C "$DIR" remote get-url origin 2>/dev/null | sed -E 's#^.*github\.com[:/]##; s#\.git$##; s#/$##')
    echo "${KELLY_CI_REPO:-${u:-messahkomlansimeon-ops/Botbet}}"
}
ci_state() {
    python - "$1" "$(ci_repo)" <<'PY'
import json, os, sys, urllib.request
sha, repo = sys.argv[1], sys.argv[2]
try:
    fx = os.environ.get("KELLY_CI_FIXTURE")
    if fx:
        raw = open(fx).read()
        if raw.strip() == "unreachable":
            raise OSError("injoignable")
        data = json.loads(raw)
    else:
        req = urllib.request.Request(f"https://api.github.com/repos/{repo}/commits/{sha}/check-runs?per_page=100",
                                     headers={"Accept": "application/vnd.github+json", "User-Agent": "kelly-update"})
        data = json.load(urllib.request.urlopen(req, timeout=15))
    runs = data["check_runs"]
except Exception as e:
    print("injoignable")
    print(f"{type(e).__name__}: {e}"[:150], file=sys.stderr)      # la cause (certificats, DNS, limite de l'API...) s'affiche au lieu d'être avalée
    sys.exit(0)
if any(r.get("status") == "completed" and r.get("conclusion") not in ("success", "skipped", "neutral") for r in runs):
    print("rouge")
elif not runs or any(r.get("status") != "completed" for r in runs):
    print("en cours")
else:
    print("verte")
PY
}
ci_gate() {      # $1 : commit à installer, $2 : --force ; code 1 = refus
    local s
    s=$(ci_state "$1")
    case "$s" in
        verte) echo "✅ CI : verte" ;;
        injoignable) echo "⚠️ CI : injoignable (GitHub ne répond pas) : j'installe quand même, le test de démarrage reste fait." ;;
        *)
            echo "CI : $s"
            if [ "$2" = "--force" ]; then echo "⚠️ --force : j'installe malgré la CI ($s)."; return 0; fi
            if [ "$s" = "rouge" ]; then echo "❌ Mise à jour refusée : les tests de ce commit échouent sur GitHub. Kelly continue avec la version actuelle (kelly update --force pour passer outre)."
            else echo "❌ Mise à jour refusée : les tests de ce commit tournent encore sur GitHub (une dizaine de minutes). Réessaie plus tard (kelly update --force pour passer outre)."; fi
            return 1 ;;
    esac
}

# passage en cours (matin, horaire, suivi) : « kelly update » et « kelly restart » l'attendent (15 min au plus) au lieu de le couper ; --now coupe quand même.
# KELLY_PASS_BUSY_FILE (tests) : tant que ce fichier existe, un passage est « en cours » ; KELLY_WAIT_MAX / KELLY_WAIT_STEP : secondes (900 / 30 par défaut).
busy_pass() {
    if [ -n "$KELLY_PASS_BUSY_FILE" ]; then [ -e "$KELLY_PASS_BUSY_FILE" ]; return; fi
    pgrep -f "bot\.py (--daily|--track|--watch)" > /dev/null
}
has_flag() { local f="$1"; shift; for a in "$@"; do [ "$a" = "$f" ] && return 0; done; return 1; }
wait_pass() {      # $@ : les arguments de la commande ; --now : pas d'attente
    has_flag --now "$@" && return 0
    busy_pass || return 0
    local max="${KELLY_WAIT_MAX:-900}" step="${KELLY_WAIT_STEP:-30}" t0 waited left
    t0=$(date +%s)
    while busy_pass; do
        waited=$(( $(date +%s) - t0 ))
        if [ "$waited" -ge "$max" ]; then
            echo "⏱️ Passage toujours en cours après $(( max / 60 )) min : j'installe quand même (kelly update --now coupe tout de suite)."
            return 0
        fi
        left=$(( (max - waited + 59) / 60 ))
        echo "⏳ passage en cours, mise à jour dans ${left} min"
        sleep "$step"
    done
    echo "✅ Passage terminé."
}

case "$1" in
    wait-pass) shift; wait_pass "$@" ;;
    ci-state) ci_state "$2" ;;
    ci-gate) ci_gate "$2" "$3" ;;
    start)
        cd "$DIR" || exit 1
        mkdir -p logs
        rm -f "$STOPPED"
        install_boot
        start_guard
        if running; then
            echo "⚠️ Kelly est déjà en cours d'exécution."
        else
            if has termux-wake-lock; then
                termux-wake-lock && export KELLY_WAKELOCK=1 && echo "🔒 Wake-lock activé : Android ne met plus Kelly en sommeil."
            else
                echo "⚠️ termux-wake-lock introuvable : pkg install termux-tools, ou touche « Acquire wakelock » dans la notification Termux."
            fi
            [ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"     # le journal d'avant est gardé (kelly logs-avant) : une panne reste lisible après un redémarrage
            KELLY_LOG="$LOG" nohup python -u termux_runner.py >> "$LOG" 2>&1 &
            sleep 3
            if running; then echo "🚀 Kelly démarrée en arrière-plan."; else echo "❌ Kelly n'a pas démarré : kelly logs"; fi
        fi
        ;;
    stop)
        mkdir -p "$DIR/logs" && touch "$STOPPED"
        pkill -f "kelly guard"
        pkill -f "termux_runner.py"
        pkill -f "bot.py"
        for i in $(seq 1 20); do
            pgrep -f "termux_runner.py|bot.py" > /dev/null || break
            sleep 1
        done
        pkill -9 -f "termux_runner.py|bot.py" 2>/dev/null
        has termux-wake-unlock && termux-wake-unlock
        echo "🛑 Kelly arrêtée."
        ;;
    restart)
        shift
        wait_pass "$@"
        "$0" stop
        "$0" start
        ;;
    update)
        shift                                   # il ne reste que les options : --force (CI), --now (ne pas attendre un passage)
        # mise à jour SÛRE : la nouvelle version est testée avant d'être lancée ; si elle ne marche pas, retour automatique à la version d'avant
        cd "$DIR" || exit 1
        mkdir -p logs
        old=$(git rev-parse HEAD)
        force=""; has_flag --force "$@" && force="--force"
        if git fetch -q 2>/dev/null; then       # la CI du commit à installer (le dernier de la branche suivie) doit être verte, avant de toucher à quoi que ce soit
            new=$(git rev-parse '@{u}' 2>/dev/null)
            if [ -n "$new" ] && [ "$new" != "$old" ]; then ci_gate "$new" "$force" || exit 1; fi
        fi
        wait_pass "$@"                          # un passage (matin, horaire, suivi) en cours est attendu avant de toucher au code et de relancer
        keep_mirror
        echo "🔄 Mise à jour du dépôt..."
        if ! git pull; then
            git merge --abort 2>/dev/null
            put_mirror
            echo "❌ Mise à jour impossible (réseau ou conflit) : Kelly continue avec la version actuelle."
            exit 1
        fi
        put_mirror
        if [ "$(git rev-parse HEAD)" != "$old" ]; then
            echo "🧪 Test de la nouvelle version..."
            if ! selftest; then
                keep_mirror
                git reset -q --hard "$old"
                put_mirror
                echo "❌ La nouvelle version ne démarre pas : retour automatique à la version d'avant (Kelly continue comme avant)."
                echo "   Détail : tail -n 30 $DIR/logs/update_test.log"
                notify "⚠️ Mise à jour refusée : la nouvelle version ne démarrait pas sur le téléphone. Kelly continue avec la version d'avant, rien n'a changé pour toi."
                exit 1
            fi
            echo "✅ Nouvelle version testée."
        else
            echo "✅ Déjà à jour."
        fi
        ( cd "$DIR" && python tools/config_active.py ) > /dev/null 2>&1      # CONFIG_ACTIVE.md : réglages actifs de cette machine (à chaque mise à jour)
        cp "$DIR/scripts/kelly" "$PREFIX/bin/kelly" && chmod +x "$PREFIX/bin/kelly"
        exec "$PREFIX/bin/kelly" restart --now "$@"       # déjà attendu plus haut : pas de seconde attente de 15 min
        ;;
    guard)
        # interne (lancé par « kelly start ») : toutes les 5 min, relance Kelly si elle s'est arrêtée sans « kelly stop »
        cd "$DIR" || exit 1
        while sleep 300; do
            [ -f "$STOPPED" ] && break
            if ! running; then
                echo "[garde $(date -u '+%Y-%m-%d %H:%M:%S')Z] Kelly s'était arrêtée sans « kelly stop » : relance" >> "$LOG"
                KELLY_LOG="$LOG" nohup python -u termux_runner.py >> "$LOG" 2>&1 &
            fi
        done
        ;;
    logs)
        tail -n 50 -f "$LOG"
        ;;
    logs-avant)
        # journal du lancement précédent (avant le dernier kelly start / restart / update)
        if [ -f "$LOG.1" ]; then tail -n 80 "$LOG.1"; else echo "Pas de journal précédent."; fi
        ;;
    rejeu|replay)
        # rejoue la saison passée (CSV football-data déjà en cache, aucune requête) ; Kelly prévient sur Telegram à la fin
        cd "$DIR" || exit 1
        mkdir -p logs
        if pgrep -f "bot.py --replay" > /dev/null; then
            echo "⏳ Le rejeu tourne déjà : kelly rejeu-log pour le suivre."
        else
            nohup python -u bot.py --replay $2 > "$DIR/logs/replay.log" 2>&1 &
            echo "📚 Rejeu de la saison passée lancé (10 à 30 min). Kelly t'enverra un message sur Telegram à la fin."
            echo "   Pour suivre : kelly rejeu-log"
        fi
        ;;
    marches|marchés)
        # marchés par championnat (coupes comprises) et par sens : kelly marches [tirs | corners | ldc…] (lecture seule)
        cd "$DIR" || exit 1
        shift
        python tools/marches.py "$@"
        ;;
    restaurer|restore)
        # kelly restaurer [fichier.zip] : installe une sauvegarde reçue sur Telegram (sans fichier : la plus récente des téléchargements),
        # Kelly arrêtée pendant ce temps puis relancée ; l'ancienne base est gardée à côté (data/kelly.db.avant-restauration-…)
        cd "$DIR" || exit 1
        [ -d "$HOME/storage" ] || { has termux-setup-storage && termux-setup-storage && sleep 3; }
        was=0; running && was=1
        [ "$was" = 1 ] && "$0" stop
        if python bot.py --restore ${2:+"$2"}; then
            echo "🚀 Relance de Kelly..."
            "$0" start
        else
            [ "$was" = 1 ] && "$0" start
            exit 1
        fi
        ;;
    fils|topics)
        # kelly fils [refaire] : crée les fils (sujets) du groupe Telegram configuré dans TELEGRAM_CHAT_ID ; relançable sans risque
        cd "$DIR" || exit 1
        python bot.py --topics ${2:+"$2"}
        ;;
    suivi)
        # contrôle du suivi des matchs et des notifications (lecture seule)
        cd "$DIR" || exit 1
        python tools/suivi.py
        ;;
    erreurs|journal)
        # résumé du journal (erreurs, avertissements, plantages) des dernières 24 h, ou « kelly erreurs 48 » : à coller tel quel pour un contrôle
        cd "$DIR" || exit 1
        python tools/erreurs.py "${2:-24}"
        ;;
    test-alerte)
        # vérifie la surveillance extérieure : healthchecks.io doit t'écrire sur Telegram « en panne » (test), puis « ok » 5 min après
        cd "$DIR" || exit 1
        python termux_runner.py --test-alerte
        ;;
    rejeu-log)
        tail -n 30 -f "$DIR/logs/replay.log"
        ;;
    doctor)
        echo "🩺 Diagnostic de Kelly"
        if running; then echo "✅ Kelly tourne (runner PID: $(pgrep -f termux_runner.py | head -n1))"; else echo "❌ Kelly est arrêtée : kelly start"; fi
        if has termux-wake-lock; then echo "✅ Commande termux-wake-lock disponible"; else echo "❌ termux-wake-lock absente : pkg install termux-tools"; fi
        if pgrep -f "kelly guard" > /dev/null; then echo "✅ Garde active (relance Kelly si elle s'arrête)"; else echo "⚠️ Garde absente : kelly restart"; fi
        if [ ! -x "$BOOT" ]; then echo "⚠️ Relance au démarrage absente : installe Termux:Boot (F-Droid), ouvre-le une fois, puis kelly restart"
        elif [ -f "$DIR/logs/boot.log" ]; then echo "✅ Relance au démarrage du téléphone : déjà utilisée ($(tail -n 1 "$DIR/logs/boot.log" | cut -c1-60))"
        else echo "⚪ Relance au démarrage prête, jamais encore utilisée : vérifie que l'appli Termux:Boot est installée et ouverte une fois"; fi
        if grep -Eq "^(export )?HC_PING_URL[=:]." "$DIR/.env" 2>/dev/null; then echo "✅ Surveillance extérieure (healthchecks.io) réglée"; else echo "⚠️ Surveillance extérieure non réglée : HC_PING_URL absent du .env"; fi
        [ -f "$LOG" ] && grep "signal de vie\|Surveillance extérieure" "$LOG" | tail -n 1 | cut -c1-160
        if [ -f "$LOG" ]; then
            grep -q "wake-lock demandé" "$LOG" && echo "✅ Wake-lock demandé au démarrage" || echo "⚠️ Wake-lock non demandé au dernier démarrage : kelly restart"
            last=$(grep -E "matin|--daily" "$LOG" | tail -n 1)
            [ -n "$last" ] && echo "🕓 Dernier passage du matin dans le journal : ${last:0:120}" || echo "🕓 Aucun passage du matin dans le journal actuel"
            # une ligne « échouée » par coupure (pas par essai) ; « rétablie après N échec(s) (X s) » donne sa durée
            n=$(tail -n 2000 "$LOG" | grep -c "lecture des commandes échouée")
            long=$(tail -n 2000 "$LOG" | sed -n 's/.*connexion rétablie après .* (\([0-9]*\) s).*/\1/p' | sort -n | tail -n 1)
            long=${long:-0}
            if [ "$n" -gt 20 ] || [ "$long" -gt 600 ]; then
                echo "⚠️ $n coupure(s) Telegram récente(s), la plus longue : $long s. Le téléphone coupe sans doute le réseau de Termux (voir les réglages ci-dessous)"
            else
                echo "✅ $n coupure(s) Telegram récente(s), la plus longue : $long s : normal sur un téléphone"
            fi
        else
            echo "⚠️ Pas encore de journal ($LOG)"
        fi
        echo ""
        echo "Réglages Android à vérifier (GrapheneOS) :"
        echo "  1. Paramètres > Applications > Termux > Batterie > Non restreinte"
        echo "  2. Paramètres > Applications > Termux > autorisation Réseau activée + données en arrière-plan"
        echo "  3. Après un redémarrage du téléphone : kelly start (ou Termux:Boot, voir DEPLOY_TERMUX.md)"
        ;;
    status)
        if running; then
            echo "✅ Kelly est active (runner PID: $(pgrep -f termux_runner.py | head -n1))"
        else
            echo "❌ Kelly est arrêtée."
        fi
        ;;
    *)
        echo "Usage: kelly {start|stop|restart [--now]|update [--force] [--now]|logs|logs-avant|status|doctor|suivi|marches|rejeu|rejeu-log|restaurer|test-alerte|fils|erreurs}"
        exit 1
        ;;
esac
