# Configuration Kelly
# Copier ce fichier sous .env (ce fichier est ignoré par git)

# The Odds API (gratuit 500 crédits/mois) - https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Telegram Bot (@BotFather) & ID de ton chat privé
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# API-Football (gratuit 100 requêtes/jour) - https://api-sports.io
STATS_API_KEY=your_api_football_key_here

# Proxy Webshare (résidentiel ou datacenter) pour 1xBet et 365scores
# Format : http://username:password@p.webshare.io:80
# Utilisé UNIQUEMENT pour 1xBet et 365scores (≈ 600 Mo/mois sur 3 Go gratuits).
# FotMob et BetExplorer se connectent en direct sans proxy.
XBET_PROXY=http://username:password@p.webshare.io:80
